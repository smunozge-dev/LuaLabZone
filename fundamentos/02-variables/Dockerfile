# EXTRAER UN CONTEDERO DE SOLO ALPINE LINUX, con la ultima estable
FROM alpine:latest

# EN LA CONSTRUCCIÓN DEL CONTENEDOR A PARTIR DE LA IMAGEN, QUIERO QUE EJECUTES LOS SIGUIENTES COMANDOS
# RUN:
RUN apk --update add lua5.3 lua5.3-dev luarocks5.3
# apk gestor de paquete de linux alpine
# --update, actualizar todos los paquetes correspondiente del sistema
# add, luego añadir paquetes: lua5.3... etc...


# QUIERO QUE ALOJES LOS ARCHIVOS QUE COPIARE EN LA SIGUIENTE CARPETA QUE ESTARÁ EN MI CONTENEDOR
WORKDIR 02-variables

# ¿QUE ARCHIVOS COPIARE?
# EN ESTE CASO TODO LO QUE SE ENCONTRARÁ EN LA MISMA CARPETA DE MI DOCKERFILE
COPY . .


# OPCIONAL OTRAS INSTRUCCIONES, PARA ESTE CASO, QUIERO EJECUTAR EL SCRIPT UNA VEZ INICIE YA EL CONTENEDOR CONSTRUIDO.
# LAS INSTRUCCIONES EN LA CMD DEL CONTENEDOR SE DEBEN DECLARAR ENTRE CORCHETE Y LOS ARGUMENTOS ENTRE COMILLAS Y SEPARADOS CON UNA COMA POR CADA UNA.
CMD ["lua5.3", "main.lua"]


# AHORA VE A PROBAR EL DOCKER FILE
