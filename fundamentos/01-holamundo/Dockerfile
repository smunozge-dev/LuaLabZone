# ESCOGE UN SO PARA EL CONTENEDOR CORRESPONDIENTE
FROM alpine:latest 

# EJECUTAR UN COMANDO AL MOMENTO DE MONTAR EL CONTENEDOR
# ESTO ES ESENCIAL PARA INSTALAR DEPENDENCIAS, FRAMEWORKS, LENGUAJES, ETC.
RUN apk --update add lua5.3 lua5.3-dev luarocks5.3

# ESTABLECER EL DIRECTORIO DONDE SE ENCONTRARÁ NUESTRO PROYECTO EN EL CONTENEDOR
# POR EJEMPLO /mi-app o 01-holamundo
WORKDIR /01-holamundo

# COPIA ARCHIVOS DESDE DONDE SE ENCUENTRA NUESTRO DOCKER FILE AL DIRECTORIO QUE SE ENCUENTRA NUESTRO PROYECTO DENTRO DEL CONTENEDOR
# PARA ESTE CASO COPIARA TODO (.), EN EL CONTENEDOR
COPY . .

# PODEMOS ESPECIFICAR ARCHIVOS TAMBIÉN EN LUGAR DEL PROYECTO COMPLETO, EN CASO DE INFORMACIÓN SENSIBLE, PODEMOS USAR .DOCKERIGNORE


# ESTABLECER EL COMANDO POR DEFECTO AL INICIAR EL CONTENEDOR, NO CONFUNDIR CON RUN QUE ESTE SE EJECUTA MIENTRAS SE CONSTRUYE EL CONTENEDOR.
# PARA ESTE CASO, SE EJECUTARÁ EL SCRIPT AL INICIAR.

CMD ["lua5.3","main.lua"]
